<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Background colors -->
    <SolidColorBrush x:Key="WindowBackground"     Color="#F0F2F5"/>
    <SolidColorBrush x:Key="SidebarBackground"    Color="#E4E7EC"/>
    <SolidColorBrush x:Key="TileBackground"       Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TileHover"            Color="#F0F2F5"/>
    <SolidColorBrush x:Key="TilePressed"          Color="#E4E7EC"/>
    <SolidColorBrush x:Key="TileBorder"           Color="#D0D7DE"/>
    <SolidColorBrush x:Key="AccentColor"          Color="#0969DA"/>
    <SolidColorBrush x:Key="AccentHover"          Color="#0550AE"/>
    <SolidColorBrush x:Key="CategoryActive"       Color="#0969DA"/>
    <SolidColorBrush x:Key="CategoryInactive"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CategoryBorder"       Color="#D0D7DE"/>
    <SolidColorBrush x:Key="HeaderBackground"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DialogBackground"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBackground"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorder"          Color="#D0D7DE"/>
    <SolidColorBrush x:Key="SeparatorColor"       Color="#D0D7DE"/>

    <!-- Text colors -->
    <SolidColorBrush x:Key="PrimaryText"          Color="#1F2328"/>
    <SolidColorBrush x:Key="SecondaryText"        Color="#57606A"/>
    <SolidColorBrush x:Key="TileNameText"         Color="#1F2328"/>
    <SolidColorBrush x:Key="CategoryActiveText"   Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CategoryInactiveText" Color="#57606A"/>
    <SolidColorBrush x:Key="ButtonText"           Color="#FFFFFF"/>
    <SolidColorBrush x:Key="DangerColor"          Color="#CF222E"/>
    <SolidColorBrush x:Key="DangerHover"          Color="#A40E26"/>

    <!-- Scrollbar -->
    <SolidColorBrush x:Key="ScrollbarThumb"       Color="#D0D7DE"/>
    <SolidColorBrush x:Key="ScrollbarTrack"       Color="#F0F2F5"/>

</ResourceDictionary>
