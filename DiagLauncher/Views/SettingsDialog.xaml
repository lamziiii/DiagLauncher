<Window x:Class="DiagLauncher.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paramètres"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent">

    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,16,0,8"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground"             Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontSize"               Value="13"/>
            <Setter Property="Margin"                 Value="0,0,20,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor"                 Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"             Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontSize"               Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor"                 Value="Hand"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"     Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"        Value="22,10"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Ombre portée -->
    <Border Margin="10" CornerRadius="12"
            Background="{DynamicResource DialogBackground}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35" Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>   <!-- Barre de titre -->
                <RowDefinition Height="1"/>    <!-- Séparateur -->
                <RowDefinition Height="*"/>    <!-- Contenu -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ══ TITRE ══ -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0"
                    Background="{DynamicResource HeaderBackground}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Rectangle Width="3" Height="18" RadiusX="2" RadiusY="2"
                                   Fill="{DynamicResource AccentColor}" Margin="0,0,10,0"/>
                        <TextBlock Text="Paramètres"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Fermer -->
                    <Button Grid.Column="2" Width="32" Height="32"
                            Click="Close_Click" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="6" Background="Transparent"
                                        Width="32" Height="32">
                                    <TextBlock Text="✕" FontSize="12"
                                               Foreground="{DynamicResource SecondaryText}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerColor}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Séparateur -->
            <Rectangle Grid.Row="1" Fill="{DynamicResource SeparatorColor}"/>

            <!-- ══ CONTENU ══ -->
            <StackPanel Grid.Row="2" Margin="24,4,24,16">

                <!-- Thème -->
                <TextBlock Text="THÈME" Style="{StaticResource SectionLabel}"/>
                <Border Background="{DynamicResource TileBackground}"
                        BorderBrush="{DynamicResource TileBorder}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="16,12">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ThemeSystem" Content="Système"
                                     Checked="Theme_Checked" Tag="System"/>
                        <RadioButton x:Name="ThemeDark"   Content="Sombre"
                                     Checked="Theme_Checked" Tag="Dark"/>
                        <RadioButton x:Name="ThemeLight"  Content="Clair"
                                     Checked="Theme_Checked" Tag="Light"/>
                    </StackPanel>
                </Border>

                <!-- Démarrage -->
                <TextBlock Text="DÉMARRAGE WINDOWS" Style="{StaticResource SectionLabel}"/>
                <Border Background="{DynamicResource TileBackground}"
                        BorderBrush="{DynamicResource TileBorder}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Lancer DiagLauncher au démarrage"
                                       FontSize="13" Foreground="{DynamicResource PrimaryText}"/>
                            <TextBlock Text="L'application démarre automatiquement avec Windows"
                                       FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <!-- Toggle switch custom -->
                        <Border Grid.Column="1" x:Name="ToggleBorder"
                                Width="42" Height="24" CornerRadius="12"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                MouseLeftButtonUp="Toggle_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource InputBorder}"/>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Ellipse x:Name="ToggleKnob"
                                         Width="18" Height="18"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Version -->
                <TextBlock Text="À PROPOS" Style="{StaticResource SectionLabel}"/>
                <Border Background="{DynamicResource TileBackground}"
                        BorderBrush="{DynamicResource TileBorder}"
                        BorderThickness="1" CornerRadius="8"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="DiagLauncher"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="Lanceur d'applications de diagnostic et cartographie"
                                   FontSize="11" Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ══ FOOTER ══ -->
            <Border Grid.Row="3"
                    BorderBrush="{DynamicResource SeparatorColor}" BorderThickness="0,1,0,0"
                    CornerRadius="0,0,12,12"
                    Background="{DynamicResource HeaderBackground}"
                    Padding="24,14">
                <Button Content="Fermer" Style="{StaticResource BtnPrimary}"
                        HorizontalAlignment="Right"
                        Click="Close_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
