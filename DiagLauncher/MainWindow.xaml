<Window x:Class="DiagLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:DiagLauncher.Converters"
        Title="DiagLauncher"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
        <conv:ExeToIconConverter x:Key="ExeToIcon"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:EqualityConverter x:Key="EqualityConv"/>

        <!-- Scrollbar -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="{DynamicResource ScrollbarThumb}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="{TemplateBinding Background}" RadiusX="3" RadiusY="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="{DynamicResource ScrollbarTrack}"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category pill button -->
        <Style x:Key="CategoryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CategoryInactive}"/>
            <Setter Property="Foreground" Value="{DynamicResource CategoryInactiveText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CategoryBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource CategoryActiveText}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- App tile button -->
        <Style x:Key="AppTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource TileBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TileBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBd" Property="Background" Value="{DynamicResource TileHover}"/>
                                <Setter TargetName="TileBd" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBd" Property="Background" Value="{DynamicResource TilePressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon/header button -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TileHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource SeparatorColor}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                          Fill="{DynamicResource AccentColor}" Width="22" Height="22"
                          Stretch="Uniform" Margin="0,0,10,0"/>
                    <TextBlock Text="DIAG LAUNCHER" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding AddAppCommand}"
                            ToolTip="Ajouter une application">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="+" FontSize="20" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentColor}" Margin="0,0,4,0"/>
                            <TextBlock Text="Ajouter" FontSize="13" Foreground="{DynamicResource SecondaryText}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource IconButtonStyle}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Paramètres"
                            Margin="8,0,0,0">
                        <TextBlock Text="⚙" FontSize="20" Foreground="{DynamicResource SecondaryText}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ CATEGORY BAR ═══ -->
        <Border Grid.Row="1" Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource SeparatorColor}" BorderThickness="0,0,0,1"
                Padding="20,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Height="38">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="CatBtn"
                                    Content="{Binding}"
                                    Style="{StaticResource CategoryButtonStyle}"
                                    Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Value="True">
                                    <DataTrigger.Binding>
                                        <MultiBinding>
                                            <MultiBinding.Converter>
                                                <conv:EqualityConverter/>
                                            </MultiBinding.Converter>
                                            <Binding/>
                                            <Binding Path="DataContext.SelectedCategory"
                                                     RelativeSource="{RelativeSource AncestorType=Window}"/>
                                        </MultiBinding>
                                    </DataTrigger.Binding>
                                    <Setter TargetName="CatBtn" Property="Background" Value="{DynamicResource CategoryActive}"/>
                                    <Setter TargetName="CatBtn" Property="Foreground" Value="{DynamicResource CategoryActiveText}"/>
                                    <Setter TargetName="CatBtn" Property="BorderBrush" Value="{DynamicResource CategoryActive}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ═══ APP GRID ═══ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12,12,18,12">
            <Grid>
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,80,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilteredApps.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Aucune application" FontSize="18"
                               Foreground="{DynamicResource SecondaryText}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Cliquez sur + Ajouter pour commencer" FontSize="13"
                               Foreground="{DynamicResource SecondaryText}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Tiles -->
                <ItemsControl ItemsSource="{Binding FilteredApps}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource AppTileStyle}"
                                    Width="165" Height="165"
                                    Command="{Binding DataContext.LaunchAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="✏ Modifier"
                                                  Command="{Binding PlacementTarget.Tag.EditAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="🗑 Supprimer"
                                                  Command="{Binding PlacementTarget.Tag.DeleteAppCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>

                                <Grid ClipToBounds="True">
                                    <!-- Top accent bar -->
                                    <Rectangle Height="4" VerticalAlignment="Top"
                                               Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"/>

                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                Margin="12,12,12,12">
                                        <!-- Icon container -->
                                        <Grid Width="60" Height="60" Margin="0,0,0,10" HorizontalAlignment="Center">
                                            <Ellipse Fill="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                     Opacity="0.12"/>
                                            <!-- First letter fallback -->
                                            <TextBlock FontSize="24" FontWeight="Bold"
                                                       Foreground="{Binding ColorHex, Converter={StaticResource HexToBrush}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <Binding Path="Name">
                                                        <Binding.Converter>
                                                            <conv:FirstCharConverter/>
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <!-- Real exe icon -->
                                            <Image Source="{Binding ExecutablePath, Converter={StaticResource ExeToIcon}}"
                                                   Width="42" Height="42"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TileNameText}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="140"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   TextAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
